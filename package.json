{
  "name": "reelcraft",
  "version": "0.1.0",
  "description": "Tooling around HyperFrames for agent-made motion graphics: scaffolding, offline vendoring, static checks, licensed assets, memory and an MCP server.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eljonathas/reelcraft.git"
  },
  "bin": {
    "reelcraft": "dist/cli.js"
  },
  "files": [
    "dist",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "animejs": "4.5.0",
    "cheerio": "1.2.0",
    "commander": "15.0.0",
    "css-tree": "3.2.1",
    "domhandler": "5.0.3",
    "gsap": "3.15.0",
    "hyperframes": "0.8.164",
    "lottie-web": "5.13.0",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/css-tree": "3.2.0",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
